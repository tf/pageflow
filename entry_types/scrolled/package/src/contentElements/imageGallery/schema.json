{
  "$id": "pageflow-scrolled/contentElements/imageGallery",
  "x-subject": {"model": "contentElement", "typeName": "imageGallery"},
  "type": "object",
  "properties": {
    "captions": {
      "type": "object",
      "additionalProperties": {"x-richText": true}
    },
    "items": {
      "type": "array",
      "items": {"$ref": "#/$defs/item"}
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "properties": {
        "image": {
          "type": "integer",
          "x-fileCollection": "image_files"
        },
        "portraitImage": {
          "type": "integer",
          "x-fileCollection": "image_files"
        }
      }
    }
  }
}
