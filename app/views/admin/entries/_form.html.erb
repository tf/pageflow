<% duplicating = local_assigns.fetch(:duplicating, false) %>
<% entry = local_assigns.fetch(:entry, resource) %>
<%= admin_form_for([:admin, entry],
                   url: duplicating ? duplicate_admin_entry_path(resource) : nil,
                   data: {root_permalink: entry.persisted? && entry.permalink&.slug == '',
                          duplicate_entry_id: duplicating ? resource.id : nil,
                          account_id: entry.account_id}) do |f| %>
  <%= f.semantic_errors(*entry.errors.attribute_names) %>
  <%= f.inputs do %>
    <%= f.input(:title,
                hint: entry.site.permalink_directories.blank? &&
                      I18n.t('pageflow.admin.entries.title_hint')) %>

    <% if authorized?(:update_account_on, resource) &&
          account_policy_scope.entry_creatable.many? %>
      <%= f.input(:account,
                  as: :searchable_select,
                  include_blank: false,
                  ajax: {
                    resource: Pageflow::Entry,
                    collection_name: :eligible_accounts
                  },
                  input_html: {class: 'entry_account_input'}) %>
    <%end %>

    <%= render('admin/entries/site_input',
               entry: entry,
               authorization_entry: resource,
               form: f) %>

    <%= f.fields_for(:permalink, entry.permalink || Pageflow::Permalink.new) do |permalink| %>
      <%= render('admin/entries/permalink_inputs',
                 entry: entry,
                 form: permalink) %>
    <% end %>

    <% if entry.new_record? && !duplicating %>
      <%= render('pageflow/admin/entries/entry_type_name_input',
                 form: f,
                 entry_types: Pageflow.config_for(resource.account).entry_types) %>
    <% end %>

    <% if authorized?(:configure_folder_for, resource) %>
      <% folder_collection = collection_for_folders(entry.account, entry.folder) %>
      <%= f.input(:folder,
                  collection: folder_collection,
                  include_blank: true) unless folder_collection.empty? %>
    <% end %>

    <% entry_config = Pageflow.config_for(entry) %>
    <% entry_config.admin_form_inputs.find_all_for(:entry).each do |form_input| %>
      <%= form_input.build(f) %>
    <% end %>
    <% if duplicating && resource.memberships.any? %>
      <%= f.input(:copy_memberships,
                  as: :radio,
                  label: t('pageflow.admin.entries.members'),
                  required: false,
                  collection: [
                    [t('pageflow.admin.entries.copy_memberships'), '1', {checked: @copy_memberships}],
                    [t('pageflow.admin.entries.without_memberships'), '0', {checked: !@copy_memberships}]
                  ],
                  input_html: {name: 'copy_memberships'}) %>
    <% end %>
  <% end %>

  <% if duplicating %>
    <%= f.actions do %>
      <%= f.action(:submit, label: t('pageflow.admin.entries.duplicate')) %>
      <%= f.cancel_link(admin_entry_path(resource)) %>
    <% end %>
  <% else %>
    <%= f.actions :submit, :cancel %>
  <% end %>
<% end %>
